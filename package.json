{
  "name": "full-follow",
  "private": true,
  "version": "0.1.0",
  "description": "Müşteri bulmaktan teslime tek sistemde kişisel CRM",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -b packages/core packages/server packages/mcp",
    "test": "npm run test -w @fullfollow/core",
    "start": "npm run build && node packages/server/dist/main.js",
    "mcp": "node packages/mcp/dist/index.js",
    "db:generate": "npm run db:generate -w @fullfollow/core"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
