{
  "name": "full-follow",
  "private": true,
  "version": "0.1.0",
  "description": "Küçük işletmeler ve şahıs şirketleri için CRM",
  "workspaces": [
    "packages/*",
    "packages/modules/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:modules": "node scripts/gen-modules.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:modules": "node scripts/check-modules.mjs",
    "build": "node scripts/gen-modules.mjs && npm run check:boundaries && npm run check:text && node scripts/build.mjs && npm run build -w @fullfollow/web",
    "test": "node scripts/test.mjs",
    "start": "node scripts/start.mjs",
    "serve": "node scripts/start.mjs --no-build",
    "backup": "node scripts/backup.cjs",
    "demo:seed": "node scripts/demo-seed.cjs",
    "dev:web": "npm run dev -w @fullfollow/web",
    "mcp": "node packages/mcp/dist/index.js",
    "db:generate": "npm run db:generate -w @fullfollow/core",
    "check:text": "node scripts/check-text.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "scarfSettings": {
    "enabled": false
  }
}
