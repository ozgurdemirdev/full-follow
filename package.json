{
  "name": "full-follow",
  "private": true,
  "version": "0.1.0",
  "description": "Küçük işletmeler ve şahıs şirketleri için CRM",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/server packages/mcp && npm run build -w @fullfollow/web",
    "test": "npm run test -w @fullfollow/core",
    "start": "node scripts/start.mjs",
    "serve": "node scripts/start.mjs --no-build",
    "backup": "node scripts/backup.cjs",
    "dev:web": "npm run dev -w @fullfollow/web",
    "mcp": "node packages/mcp/dist/index.js",
    "db:generate": "npm run db:generate -w @fullfollow/core"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
