{
  "name": "@fullfollow/mod-timeline",
  "version": "0.1.0",
  "private": true,
  "description": "Full Follow timeline module: the event history of a record, the global feed and the week strip",
  "fullfollow": { "module": "timeline", "endpoints": ["/timeline"] },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": { "*": { "server": ["dist/server/index.d.ts"] } },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server": { "types": "./dist/server/index.d.ts", "default": "./dist/server/index.js" }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@fullfollow/core": "*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^5.0.3"
  }
}
