# Kopyala: .env  (git'e girmez)
# Web arayüzü şifresi. Boşsa sunucu sadece bu bilgisayardan (127.0.0.1) erişilebilir açılır.
FF_PASSWORD=
# Çerez imzası için rastgele uzun bir metin (boşsa ilk açılışta rastgele üretilip data/session.key dosyasına yazılır)
FF_COOKIE_SECRET=
# Port (varsayılan 3000)
FF_PORT=3000
# Veritabanı yolu (varsayılan data/fullfollow.db)
# FF_DB=
# Dinlenecek adres (boşsa: şifre varsa 0.0.0.0 yani yerel ağ, yoksa 127.0.0.1). Şifre yokken 127.0.0.1 dışında bir adres verilirse sunucu açılmaz.
# FF_HOST=
# Sunucuya bu adlarla da ulaşılabilsin (virgülle). localhost, 127.0.0.1, [::1] ve bilgisayarın kendi IP adresleri her zaman kabul edilir;
# başka bir Host başlığı (örn. telefondan pc.local yazarak girersen) 421 ile reddedilir, adı buraya ekle
# FF_ALLOWED_HOSTS=
# Günlük otomatik yedek (data/backups). 0 yazarsan kapanır
# FF_BACKUP=1
# Kaç günlük yedek tutulsun
# FF_BACKUP_KEEP=14
# Panel sohbeti (Claude Code CLI gerekir, README "Panel sohbeti")
# Claude Code çalıştırılabilir dosyasının tam yolu (boşsa PATH'ten bulunur)
# FF_CLAUDE_CLI=
# Claude'un çalışma klasörü (içindeki CLAUDE.md iş bağlamı olur). Yoksa data/chat kullanılır
# FF_CHAT_CWD=
# Sohbet için ayrı Claude hesabının yapılandırma klasörü
# FF_CLAUDE_CONFIG_DIR=
