# Kopyala: .env  (git'e girmez)
# Web arayüzü şifresi. Boşsa sunucu sadece bu bilgisayardan (127.0.0.1) erişilebilir açılır.
FF_PASSWORD=
# Çerez imzası için rastgele uzun bir metin (boşsa şifreden türetilir)
FF_COOKIE_SECRET=
# Port (varsayılan 3000)
FF_PORT=3000
# Veritabanı yolu (varsayılan data/fullfollow.db)
# FF_DB=
# Dinlenecek adres (boşsa: şifre varsa 0.0.0.0 yani yerel ağ, yoksa 127.0.0.1)
# FF_HOST=
# Günlük otomatik yedek (data/backups). 0 yazarsan kapanır
# FF_BACKUP=1
# Kaç günlük yedek tutulsun
# FF_BACKUP_KEEP=14
